# Copy to .env.local for local builds. No secrets belong in NEXT_PUBLIC_*.
API_BASE_URL=https://innovera-testing-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://innovera-testing-production.up.railway.app
CHATBOT_API_BASE_URL=https://innovera-testing-production.up.railway.app/chatbot/api
NEXT_PUBLIC_DEPLOYMENT_ENV=production
# Use your actual preview or final site URL:
APP_URL=https://www.innoveracorp.com
# Set these only if your existing deployment uses a live Directus CMS:
# DIRECTUS_URL=https://your-cms.example.com
# NEXT_PUBLIC_DIRECTUS_URL=https://your-cms.example.com
# DIRECTUS_ADMIN_TOKEN=add-privately
# Do not set NEXT_STATIC_EXPORT or NEXT_PUBLIC_STATIC_EXPORT for Workers.

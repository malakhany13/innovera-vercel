{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "innovera",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "innovera" }
  ],
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "innovera-next-cache" }
  ],
  "vars": {
    "API_BASE_URL": "https://innovera-testing-production.up.railway.app",
    "CHATBOT_API_BASE_URL": "https://innovera-testing-production.up.railway.app/chatbot/api"
  }
}
